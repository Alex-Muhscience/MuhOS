#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# MuhOS (Fedora): started by muhos-shell.service. Puts the upstream command
# names the shell calls internally on PATH, then runs the shell daemon.
PATH="/usr/libexec/muhos:$PATH"
export PATH
# One consistent icon theme for app icons in the shell (dock, launcher, tray);
# only the shell is affected, not the user's GTK/Qt apps.
if [ -z "${QS_ICON_THEME:-}" ] && [ -d /usr/share/icons/Adwaita ]; then
    QS_ICON_THEME=Adwaita
    export QS_ICON_THEME
fi
exec /usr/libexec/muhos/serpantinumd start
