[Desktop Entry]
Type=Application
Name=MuhOS Settings
Comment=Configure the MuhOS desktop: appearance, bar, dock, wallpapers and more
Exec=muhos msg open guide
Icon=preferences-system
Terminal=false
Categories=Settings;DesktopSettings;
Keywords=settings;preferences;theme;wallpaper;bar;dock;
# Hyprland reports itself to apps as "Hyprland", so the entry cannot be limited
# to the MuhOS session by name; it is hidden in the other common desktops.
NotShowIn=GNOME;KDE;XFCE;
