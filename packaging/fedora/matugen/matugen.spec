# MuhOS: Matugen 4.2.0 for Fedora 44, which ships 3.1.0. Based on the Fedora
# rust-matugen spec (src.fedoraproject.org/rpms/rust-matugen); changes:
# version 4.2.0, dependencies vendored with make-vendor-tarball, Fedora's
# 3.1.0 metadata patches dropped. Built with default features only
# (dump-json, jxl-image): the optional update check (update-informer) and
# web image download (reqwest) are not compiled in.

%bcond check 1

%global crate matugen

Name:           matugen
Version:        4.2.0
Release:        1.muhos1%{?dist}
Summary:        Material You and base16 color generation tool with templates

# matugen: GPL-2.0-or-later. Vendored crates (from licenses.txt written by
# make-vendor-tarball; LICENSE.dependencies holds the per-crate breakdown of
# what is actually compiled):
License:        %{shrink:
    GPL-2.0-or-later
    AND Apache-2.0
    AND BSD-2-Clause
    AND BSD-3-Clause
    AND MIT
    AND MPL-2.0
    AND Zlib
    AND (MIT OR Apache-2.0) AND Unicode-DFS-2016
    AND (0BSD OR MIT OR Apache-2.0)
    AND (Apache-2.0 OR BSL-1.0)
    AND (Apache-2.0 OR MIT)
    AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT)
    AND (BSD-2-Clause OR Apache-2.0 OR MIT)
    AND (BSD-3-Clause OR Apache-2.0)
    AND (BSD-3-Clause OR MIT)
    AND (CC0-1.0 OR Apache-2.0)
    AND (MIT OR Apache-2.0 OR CC0-1.0)
    AND (MIT OR Apache-2.0 OR Zlib)
    AND (Unlicense OR MIT)
    AND (Zlib OR Apache-2.0 OR MIT)
}
URL:            https://github.com/InioX/matugen
Source0:        https://crates.io/api/v1/crates/%{crate}/%{version}/download#/%{crate}-%{version}.crate
# Generated by packaging/fedora/matugen/make-vendor-tarball <version>
Source1:        %{crate}-%{version}-vendor.tar.xz

BuildRequires:  cargo-rpm-macros >= 26

%description
A Material You and base16 color generation tool with templates. It derives a
color palette from an image or a color and renders it into configuration
files for other programs.

%prep
%autosetup -n %{crate}-%{version} -p1 -a1
%cargo_prep -v vendor
# Some vendored sources are marked executable; their #![...] attributes would
# be misread as shebangs.
find vendor -type f -name '*.rs' -perm /111 -exec chmod -x {} +

%build
%cargo_build
%{cargo_license_summary}
%{cargo_license} > LICENSE.dependencies
%{cargo_vendor_manifest}

%install
%cargo_install

%if %{with check}
%check
%cargo_test
%endif

%files
%license LICENSE
%license LICENSE.dependencies
%license cargo-vendor.txt
%doc CHANGELOG.md
%doc README.md
%{_bindir}/matugen

%changelog
* Sun Oct 18 2026 MuhOS contributors - 4.2.0-1.muhos1
- Update to 4.2.0 for MuhOS; vendored dependencies, default features only
