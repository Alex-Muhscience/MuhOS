#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# MuhOS (Fedora): Wayland session entry point, started by the display manager.
#
#   muhos-session             prepare per-user files if missing, then run Hyprland
#   muhos-session --prepare   only prepare per-user files, then exit
#
# Per-user files are created once and never overwritten:
#   ~/.config/muhos/hypr/hyprland.lua   stub that loads the packaged defaults
#                                       plus an optional user.lua next to it
#   ~/.config/serpantinum/settings.json shell settings, seeded from the template,
#                                       with IP geolocation off (privacy default)
#                                       and Inter as the interface font (as apps)
#   ~/Pictures/Wallpapers                MuhOS default wallpapers copied in, only
#                                       during that first setup and only if the
#                                       folder has no images yet
# Nothing else in ~/.config is touched; an existing ~/.config/hypr is ignored.

set -euo pipefail

datadir="${MUHOS_DATADIR:-/usr/share/muhos}"
libexecdir="${MUHOS_LIBEXECDIR:-/usr/libexec/muhos}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
hypr_dir="$config_home/muhos/hypr"
settings="$config_home/serpantinum/settings.json"

log() { printf 'muhos-session: %s\n' "$*" >&2; }

# Write $2 to $1 only if $1 does not exist yet; never replaces user files.
create_once() {
    local target="$1" content="$2"
    [ -e "$target" ] && return 0
    mkdir -p "$(dirname "$target")"
    printf '%s' "$content" > "$target.muhos-tmp"
    mv -n "$target.muhos-tmp" "$target"
    rm -f "$target.muhos-tmp"
    log "created $target"
}

pictures_dir() {
    local dir=""
    command -v xdg-user-dir >/dev/null 2>&1 && dir="$(xdg-user-dir PICTURES 2>/dev/null || true)"
    if [ -z "$dir" ] || [ "$dir" = "$HOME" ]; then
        dir="$HOME/Pictures"
    fi
    printf '%s' "${dir%/}"
}

prepare() {
    create_once "$hypr_dir/hyprland.lua" \
        "$(sed "s|@MUHOS_HYPR_DIR@|$datadir/hypr|g" "$datadir/skel/hyprland.lua")
"

    if [ ! -e "$settings" ]; then
        local wallpapers seeded
        wallpapers="$(pictures_dir)/Wallpapers"
        mkdir -p "$wallpapers"
        if [ -z "$(find "$wallpapers" -maxdepth 1 -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) -print -quit)" ]; then
            cp -n "$datadir/src/assets/wallpapers/"*.jpg "$wallpapers/" 2>/dev/null || true
        fi
        seeded="$(jq --arg wp "$wallpapers" '. * {wallpaperDir: $wp, general: {ipGeolocation: false}, theme: {fontFamily: "Inter"}, dock: {floating: true, hoverScale: 160, cascadeScale: true, elementSize: 48}}' "$datadir/defaults/settings.json")"
        create_once "$settings" "$seeded
"
    fi
}

if [ "${1:-}" = "--prepare" ]; then
    prepare
    exit 0
fi

prepare

# Shell helpers and compositor keybinds call the upstream command names.
export PATH="$libexecdir:$PATH"

# macOS look for apps, in this session only. GNOME/GTK settings come from
# MuhOS's own dconf database (/etc/dconf/profile/muhos: WhiteSur theme and
# icons, Inter, left-hand window buttons), so changes made here never reach
# the user's GNOME session and theirs never reach MuhOS. libadwaita apps
# ignore the gtk-theme key and only take a theme from GTK_THEME.
# Set on every login, since a value left in the user manager by an earlier
# session could otherwise carry over.
unset GTK_THEME
[ -e /etc/dconf/profile/muhos ] && export DCONF_PROFILE=muhos
# WhiteSur's dark variant does not render libadwaita (GNOME 50) apps
# correctly, so in dark mode apps use libadwaita's own dark style instead.
mode="$(jq -r '.theme.mode // "dark"' "$settings" 2>/dev/null || echo dark)"
if [ "$mode" = light ]; then
    [ -d /usr/share/themes/WhiteSur-Light ] && export GTK_THEME=WhiteSur-Light
    scheme=default
else
    scheme=prefer-dark
fi
[ "${DCONF_PROFILE:-}" = muhos ] && { gsettings set org.gnome.desktop.interface color-scheme "$scheme" 2>/dev/null || true; }

# When the session ends (normally, or by a signal such as a forced logout),
# take the shell down and don't leave MuhOS's settings profile and theme in
# the user manager for the next session, e.g. GNOME.
# Clearing the variables comes first: on a forced logout the script may be
# killed while the shell is stopping.
# shellcheck disable=SC2329  # invoked by the EXIT trap below
cleanup() {
    systemctl --user unset-environment DCONF_PROFILE GTK_THEME 2>/dev/null || true
    systemctl --user stop --no-block muhos-session.target 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 143' TERM HUP INT

status=0
start-hyprland -- --config "$hypr_dir/hyprland.lua" || status=$?
exit "$status"
