{
  "statuses": {
    "non-redistributable": "Proprietary license that forbids redistribution. Must be removed before any MuhOS release.",
    "needs-review": "License text embedded in the file conflicts with how it is shipped (e.g. a no-derivatives font shipped as a patched derivative). Needs a human decision.",
    "unknown-provenance": "No source or license recorded anywhere in the repository. Must be traced, replaced, or removed.",
    "needs-license-text": "License permits redistribution, but the required license/notice text is not shipped alongside the file.",
    "third-party-trademark": "Logo of another project; usage is governed by that project's trademark policy, not by a copyright license.",
    "upstream-branding": "Serpantinum name/logo/screenshots. AGPL permits it, but MuhOS ships its own branding, so it must be replaced.",
    "generated": "Build artifact produced from source in this repository; should be rebuilt during packaging rather than shipped as committed.",
    "ok": "Cleared for release."
  },
  "exclude": [],
  "rules": [
    {
      "match": [
        "src/assets/fonts/SymbolsNerdFontMono-Regular.ttf"
      ],
      "status": "needs-review",
      "license": "MIT + per-icon-set licenses",
      "license_files": [
        "src/assets/fonts/LICENSES/NerdFontsSymbols-LICENSE.txt",
        "src/assets/fonts/LICENSES/NerdFontsSymbols-README.md"
      ],
      "action": "'Font Logos' glyph set is listed as unlicensed; accept, subset it out, or replace"
    },
    {
      "match": [
        "src/assets/fonts/0xProtoNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1",
      "license_files": [
        "src/assets/fonts/LICENSES/0xProto-LICENSE.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/3270NerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1",
      "license_files": [
        "src/assets/fonts/LICENSES/3270-LICENSE.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/AgaveNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "MIT",
      "license_files": [
        "src/assets/fonts/LICENSES/Agave-LICENSE.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/AnonymiceProNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1",
      "license_files": [
        "src/assets/fonts/LICENSES/AnonymousPro-OFL.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/ArimoNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1",
      "license_files": [
        "src/assets/fonts/LICENSES/Arimo-OFL.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/BlexMono*.ttf",
        "src/assets/fonts/IBMPlexMono-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1",
      "license_files": [
        "src/assets/fonts/LICENSES/IBMPlexMono-LICENSE.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/ComicMono.ttf"
      ],
      "status": "ok",
      "license": "MIT",
      "license_files": [
        "src/assets/fonts/LICENSES/ComicMono-LICENSE.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/ComicShannsMonoNerdFont-Regular.otf"
      ],
      "status": "ok",
      "license": "MIT",
      "license_files": [
        "src/assets/fonts/LICENSES/ComicShannsMono-LICENSE.md"
      ]
    },
    {
      "match": [
        "src/assets/fonts/CousineNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "Apache-2.0 (embedded)",
      "license_files": [
        "src/assets/fonts/LICENSES/Apache-2.0.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/DaddyTimeMonoNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1 (per Nerd Fonts LICENSE.md; embedded string says All Rights Reserved)",
      "license_files": [
        "src/assets/fonts/LICENSES/DaddyTimeMono-LICENSE.md"
      ]
    },
    {
      "match": [
        "src/assets/fonts/DejaVuSansMNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "Bitstream-Vera AND public domain",
      "license_files": [
        "src/assets/fonts/LICENSES/DejaVuSansMono-LICENSE.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/GohuFontuni14NerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "WTFPL",
      "license_files": [
        "src/assets/fonts/LICENSES/GohuFont-COPYING-LICENSE.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/InconsolataGoNerdFont-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1",
      "license_files": [
        "src/assets/fonts/LICENSES/InconsolataGo-OFL.txt"
      ]
    },
    {
      "match": [
        "src/assets/fonts/IosevkaNerdFont-*.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1",
      "license_files": [
        "src/assets/fonts/LICENSES/Iosevka-LICENSE.md"
      ]
    },
    {
      "match": [
        "src/assets/fonts/OpenDyslexicNerdFont-Regular.otf"
      ],
      "status": "ok",
      "license": "Bitstream-Vera AND CC-BY-3.0",
      "license_files": [
        "src/assets/fonts/LICENSES/Bitstream-Vera.txt",
        "src/assets/fonts/LICENSES/CC-BY-3.0.txt"
      ],
      "action": "Attribution: OpenDyslexic changes by Abelardo Gonzalez (CC-BY-3.0)"
    },
    {
      "match": [
        "src/assets/fonts/AdwaitaMonoNerdFont-Regular.ttf",
        "src/assets/fonts/AurulentSansM*.otf",
        "src/assets/fonts/BitcountPropSingle*.ttf",
        "src/assets/fonts/EduVICWANTHand-Regular.ttf",
        "src/assets/fonts/FiraCode-Regular.ttf",
        "src/assets/fonts/JetBrainsMono-*.ttf",
        "src/assets/fonts/LektonNerdFont-Regular.ttf",
        "src/assets/fonts/Roboto-Regular.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1 (embedded; copyright in each file's name table)",
      "license_files": [
        "src/assets/fonts/LICENSES/OFL-1.1.txt"
      ]
    },
    {
      "match": [
        "config/sddm/themes/material-you/font/*.ttf"
      ],
      "status": "ok",
      "license": "OFL-1.1 (embedded)",
      "license_files": [
        "config/sddm/themes/material-you/font/OFL-1.1.txt"
      ]
    },
    {
      "match": [
        "src/assets/sounds/**",
        "src/assets/sounds/*/*",
        "src/assets/sounds/*/*/*"
      ],
      "status": "unknown-provenance",
      "license": "",
      "action": "Trace origin or replace with CC0/own recordings"
    },
    {
      "match": [
        "src/assets/pushy.gif",
        "src/assets/pushy2.gif",
        "config/sddm/themes/material-you/bg.png"
      ],
      "status": "unknown-provenance",
      "license": "",
      "action": "Trace origin or replace"
    },
    {
      "match": [
        "docs/assets/logos/*",
        "website/static/img/logos/*"
      ],
      "status": "third-party-trademark",
      "license": "Trademark of respective project",
      "action": "Check each project's trademark guidelines before reuse"
    },
    {
      "match": [
        "src/assets/logo.svg",
        "docs/assets/banner.png",
        "docs/assets/previews/*",
        "website/static/*",
        "website/static/img/*",
        "website/static/img/previews/*",
        "website/static/img/previews/steps/*"
      ],
      "status": "upstream-branding",
      "license": "AGPL-3.0-or-later (upstream)",
      "action": "Replace with MuhOS branding"
    },
    {
      "match": [
        "src/assets/shaders/*/*.qsb"
      ],
      "status": "generated",
      "license": "AGPL-3.0-or-later (compiled from .frag)",
      "action": "Rebuild with qsb during RPM build"
    }
  ]
}
