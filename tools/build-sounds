def fade(n, attack, release):
    env = np.ones(n)
    a, r = int(attack * RATE), int(release * RATE)
    if a:
        env[:a] = np.linspace(0, 1, a)
    if r:
        env[-r:] = np.minimum(env[-r:], np.linspace(1, 0, r))
    return env


def background_loop():
    """16 s ambient pad in A major. Every partial and LFO completes a whole
    number of cycles in 16 s, so the loop point is seamless."""
    seconds = 16
    t = np.arange(seconds * RATE) / RATE
    q = 1 / seconds                        # frequency grid for seamless loops
    chord = [110.0, 164.8, 220.0, 277.2, 329.6]
    left = np.zeros_like(t)
    right = np.zeros_like(t)
    for i, f in enumerate(chord):
        f = round(f / q) * q
        lfo = 0.6 + 0.4 * np.sin(2 * np.pi * (i + 1) * q * t + i)
        detune = 2 * q
        left += lfo * (np.sin(2 * np.pi * f * t) + 0.3 * np.sin(2 * np.pi * 2 * f * t)) / (i + 1.5)
        right += lfo * (np.sin(2 * np.pi * (f + detune) * t) + 0.3 * np.sin(2 * np.pi * 2 * (f + detune) * t)) / (i + 1.5)
    return np.stack([left, right], axis=1)


def charge_sweep():
    """1.5 s rising tone that builds while a button is held."""
    n = int(1.5 * RATE)
    t = np.arange(n) / RATE
    freq = 180 + 520 * (t / t[-1]) ** 1.6
    phase = 2 * np.pi * np.cumsum(freq) / RATE
    tone = np.sin(phase) + 0.35 * np.sin(2 * phase) + 0.15 * np.sin(3 * phase)
    tone *= fade(n, 0.25, 0.05) * (0.4 + 0.6 * t / t[-1])
    return np.stack([tone, tone], axis=1)


def swell():
    """3.8 s soft swell: low-passed noise that rises and settles."""
    n = int(3.8 * RATE)
    rng = np.random.default_rng(20261018)
    noise = rng.standard_normal((n, 2))
    kernel = np.hanning(400)
    kernel /= kernel.sum()
    smooth = np.stack([np.convolve(noise[:, c], kernel, mode="same") for c in range(2)], axis=1)
    t = np.arange(n) / RATE
    env = np.sin(np.pi * np.clip(t / 3.8, 0, 1)) ** 2
    return smooth * env[:, None]


