def write_wav(path, samples):
    samples = np.asarray(samples, dtype=np.float64)
    peak = np.max(np.abs(samples)) or 1.0
    pcm = np.round(samples / peak * PEAK * 32767).astype("<i2")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with wave.open(path, "wb") as w:
        w.setnchannels(pcm.shape[1] if pcm.ndim == 2 else 1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes(pcm.tobytes())


def decode(data):
    """Decode any audio file to float stereo at RATE using ffmpeg."""
    out = subprocess.run(
        ["ffmpeg", "-v", "error", "-i", "pipe:0", "-f", "f32le", "-ac", "2", "-ar", str(RATE), "pipe:1"],
        input=data, capture_output=True, check=True).stdout
    return np.frombuffer(out, dtype="<f4").reshape(-1, 2)


def fetch_pack(name):
    title, url, digest = PACKS[name]
    data = subprocess.run(["curl", "-fsSL", "--retry", "3", url], capture_output=True, check=True).stdout
    actual = hashlib.sha256(data).hexdigest()
    if actual != digest:
        sys.exit(f"{name}: sha256 mismatch ({actual})")
    archive = zipfile.ZipFile(io.BytesIO(data))
    license_text = next(archive.read(n) for n in archive.namelist() if n.lower().endswith("license.txt"))
    if b"CC0" not in license_text:
        sys.exit(f"{name}: license file does not say CC0")
    files = {}
    for member in archive.namelist():
        base, ext = os.path.splitext(os.path.basename(member))
        if ext.lower() in (".ogg", ".wav"):
            files[base] = archive.read(member)
    return files


def main():
    managed = set(KENNEY) | set(SYNTH)
    packs = {name: fetch_pack(name) for name in sorted({p for p, _ in KENNEY.values()})}

    # Remove sounds this script manages or that are no longer listed anywhere.
    for base, _, files in os.walk(OUT):
        for f in files:
            rel = os.path.relpath(os.path.join(base, f), OUT)
            if rel.endswith((".wav", ".mp3", ".ogg")) and rel not in KEPT:
                os.remove(os.path.join(OUT, rel))

    for rel, (pack, name) in sorted(KENNEY.items()):
        write_wav(os.path.join(OUT, rel), decode(packs[pack][name]))
    for rel, (make, _) in sorted(SYNTH.items()):
        write_wav(os.path.join(OUT, rel), make())

    lines = [
        "# Sound sources",
        "",
        "<!-- Generated by tools/build-sounds. Do not edit by hand. -->",
        "",
        "Every sound in this directory, where it comes from, and its license.",
        "Kenney packs are by Kenney Vleugels (https://kenney.nl), released under",
        "CC0-1.0 (https://creativecommons.org/publicdomain/zero/1.0/); converted to",
        "16-bit WAV and peak-normalized. Synthesized sounds are MuhOS originals, made",
        "by `tools/build-sounds` (their source), AGPL-3.0-or-later.",
        "",
        "| File | Source | License |",
        "|---|---|---|",
    ]
    for rel in sorted(managed | set(KEPT)):
        if rel in KENNEY:
            pack, name = KENNEY[rel]
            src = f"Kenney \"{PACKS[pack][0]}\", `{name}`"
            lic = "CC0-1.0"
        elif rel in SYNTH:
            src = "MuhOS original: " + SYNTH[rel][1]
            lic = "AGPL-3.0-or-later"
        else:
            src, lic = KEPT[rel], "CC0-1.0"
        lines.append(f"| `{rel}` | {src} | {lic} |")
    with open(os.path.join(OUT, "SOURCES.md"), "w") as fh:
        fh.write("\n".join(lines) + "\n")
    print(f"wrote {len(KENNEY)} Kenney sounds, {len(SYNTH)} synthesized, kept {len(KEPT)}")


if __name__ == "__main__":
    main()
