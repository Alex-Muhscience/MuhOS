#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# MuhOS: write CHANGES-FROM-UPSTREAM.md from labelled MuhOS commits.
#
#   tools/changes-from-upstream
#
# The upstream version comes from NOTICE ("Based on"); MuhOS changes are
# measured against its snapshot tag muhos-upstream-v<version>
# (see tools/sync-upstream).

# Backticks in the printf formats below are Markdown, not command substitution.
# shellcheck disable=SC2016
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
version="$(sed -n 's/^ *Based on: *tag v\([^,]*\),.*/\1/p' "$root/NOTICE")"
snapshot="muhos-upstream-v$version"
out="$root/CHANGES-FROM-UPSTREAM.md"

if [ -z "$version" ] || ! git -C "$root" rev-parse -q --verify "$snapshot^{commit}" >/dev/null; then
    echo "snapshot tag '$snapshot' not found; fetch tags from origin" >&2
    exit 1
fi
# First snapshot: the root of MuhOS history. MuhOS commits are the
# first-parent, non-merge commits after it.
import="$(git -C "$root" rev-list --max-parents=0 HEAD | tail -n 1)"
muhos_log() { git -C "$root" log --first-parent --no-merges "$@" "$import..HEAD"; }

section() {
    local label="$1" title="$2" lines
    lines="$(muhos_log --reverse --format='- %s (%h)' \
        | grep -F -- "- [$label] " | sed "s/^- \[$label\] /- /" || true)"
    printf '## %s\n\n%s\n\n' "$title" "${lines:-_None yet._}"
}

# Upstream files MuhOS changed or removed, with the date of the first such change.
# This is the AGPL section 5(a) modification notice referenced from NOTICE.
modified_files() {
    local file status first
    git -C "$root" diff --name-status --no-renames "$snapshot" HEAD \
        | while IFS=$'\t' read -r status file; do
            [ "$status" = "A" ] && continue
            first="$(muhos_log --reverse --format=%ad --date=short -- "$file" | head -n 1)"
            case "$status" in
                D) printf -- '- `%s` (removed %s)\n' "$file" "$first" ;;
                *) printf -- '- `%s` (modified since %s)\n' "$file" "$first" ;;
            esac
        done
}

{
    printf '# Changes from upstream Serpantinum\n\n'
    printf '<!-- Generated by tools/changes-from-upstream. Do not edit by hand. -->\n\n'
    printf 'Base: upstream Serpantinum v%s (snapshot `%s`). Labels are explained in FORK.md.\n\n' \
        "$version" "$snapshot"
    section general "General improvements (candidates for upstream)"
    section fedora "Fedora-specific"
    section brand "MuhOS branding"
    section fork "Fork infrastructure"
    files="$(modified_files)"
    printf '## Upstream files changed by MuhOS\n\n%s\n\n' "${files:-_None yet._}"
    printf '## Upstream files not imported\n\nListed in `tools/upstream-exclude.txt`:\n\n'
    grep -v '^#' "$root/tools/upstream-exclude.txt" | awk 'NF { p=$1; $1=""; sub(/^ +/, ""); printf "- `%s` (%s)\n", p, $0 }'
} > "$out"
