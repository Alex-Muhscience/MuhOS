#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# MuhOS: write CHANGES-FROM-UPSTREAM.md from labelled commits since the upstream base tag.
#
#   tools/changes-from-upstream [base-tag]     (default: base tag recorded in NOTICE)

# Backticks in the printf formats below are Markdown, not command substitution.
# shellcheck disable=SC2016
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
base="${1:-$(sed -n 's/^ *Based on: *tag \([^,]*\),.*/\1/p' "$root/NOTICE")}"
out="$root/CHANGES-FROM-UPSTREAM.md"

if [ -z "$base" ] || ! git -C "$root" rev-parse -q --verify "$base^{commit}" >/dev/null; then
    echo "upstream base tag '$base' not found; fetch upstream tags first" >&2
    exit 1
fi

section() {
    local label="$1" title="$2" lines
    lines="$(git -C "$root" log --reverse --format='- %s (%h)' "$base..HEAD" \
        | grep -F -- "- [$label] " | sed "s/^- \[$label\] /- /" || true)"
    printf '## %s\n\n%s\n\n' "$title" "${lines:-_None yet._}"
}

# Upstream files MuhOS changed or removed, with the date of the first such change.
# This is the AGPL section 5(a) modification notice referenced from NOTICE.
modified_files() {
    local file status first
    git -C "$root" diff --name-status --no-renames "$base" HEAD \
        | while IFS=$'\t' read -r status file; do
            [ "$status" = "A" ] && continue
            first="$(git -C "$root" log --reverse --format=%ad --date=short "$base..HEAD" -- "$file" | head -n 1)"
            case "$status" in
                D) printf -- '- `%s` (removed %s)\n' "$file" "$first" ;;
                *) printf -- '- `%s` (modified since %s)\n' "$file" "$first" ;;
            esac
        done
}

{
    printf '# Changes from upstream Serpantinum\n\n'
    printf '<!-- Generated by tools/changes-from-upstream. Do not edit by hand. -->\n\n'
    printf 'Base: upstream `%s` (`%s`). Labels are explained in FORK.md.\n\n' \
        "$base" "$(git -C "$root" rev-parse --short "$base^{commit}")"
    section general "General improvements (candidates for upstream)"
    section fedora "Fedora-specific"
    section brand "MuhOS branding"
    section fork "Fork infrastructure"
    files="$(modified_files)"
    printf '## Upstream files changed by MuhOS\n\n%s\n' "${files:-_None yet._}"
} > "$out"
