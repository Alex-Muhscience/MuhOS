#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# MuhOS: record shellcheck/qmllint warning counts and make sure they never grow.
#
#   tools/lint-baseline            write ci/lint-baseline.json
#   tools/lint-baseline --check    fail if any count is higher than the baseline
#
# Needs shellcheck and qmllint (qt6-qtdeclarative-devel) on PATH, or QMLLINT set.
# CI runs this inside a fedora:44 container; see .github/workflows/ci.yml.

import argparse
import collections
import json
import os
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BASELINE = os.path.join(ROOT, "ci", "lint-baseline.json")
EXCLUDE_PREFIXES = ("website/",)


def tracked(pred):
    out = subprocess.run(["git", "-C", ROOT, "ls-files", "-z"],
                         check=True, capture_output=True).stdout.decode()
    return sorted(p for p in out.split("\0")
                  if p and not p.startswith(EXCLUDE_PREFIXES) and pred(p))


def tool(name, env=None):
    path = os.environ.get(env) if env else None
    path = path or shutil.which(name) or (shutil.which(f"/usr/lib64/qt6/bin/{name}") if name == "qmllint" else None)
    if not path:
        sys.exit(f"{name} not found; install it or set {env or name.upper()}")
    return path


def version(cmd):
    out = subprocess.run(cmd, capture_output=True, text=True)
    lines = [l for l in (out.stdout + out.stderr).splitlines() if l.strip()]
    return " ".join(lines[:2]).strip()


def is_shell_script(path):
    if path.endswith(".sh"):
        return True
    try:
        with open(os.path.join(ROOT, path), "rb") as fh:
            first = fh.readline(128)
    except OSError:
        return False
    return first.startswith(b"#!") and first.split(b"/")[-1].split()[-1] in (b"sh", b"bash")


def run_shellcheck():
    exe = tool("shellcheck")
    files = tracked(is_shell_script)
    out = subprocess.run([exe, "-f", "json1", "-x", *files], cwd=ROOT,
                         capture_output=True, text=True)
    comments = json.loads(out.stdout or '{"comments": []}')["comments"]
    by_level = collections.Counter(c["level"] for c in comments)
    by_code = collections.Counter(f"SC{c['code']}" for c in comments)
    return {
        "version": version([exe, "--version"]),
        "files": len(files),
        "total": len(comments),
        "by_level": dict(sorted(by_level.items())),
        "by_code": dict(sorted(by_code.items())),
    }


def run_qmllint():
    exe = tool("qmllint", "QMLLINT")
    files = tracked(lambda p: p.endswith(".qml"))
    with tempfile.TemporaryDirectory() as tmp:
        report = os.path.join(tmp, "qmllint.json")
        subprocess.run([exe, "--json", report, *files], cwd=ROOT,
                       capture_output=True, text=True)
        with open(report) as fh:
            data = json.load(fh)
    by_category = collections.Counter()
    by_type = collections.Counter()
    failed = 0
    for entry in data.get("files", []):
        if not entry.get("success", True):
            failed += 1
        for w in entry.get("warnings", []):
            by_category[w.get("id") or w.get("type", "unknown")] += 1
            by_type[w.get("type", "unknown")] += 1
    return {
        "version": version([exe, "--version"]),
        "files": len(files),
        "files_with_errors": failed,
        "total": sum(by_category.values()),
        "by_type": dict(sorted(by_type.items())),
        "by_category": dict(sorted(by_category.items())),
    }


def regressions(old, new, path=""):
    """Every numeric count in `new` that is higher than in `old`."""
    found = []
    for key, value in new.items():
        where = f"{path}.{key}" if path else key
        if isinstance(value, dict):
            found += regressions(old.get(key, {}), value, where)
        elif isinstance(value, int) and key != "files":
            before = old.get(key, 0)
            if value > before:
                found.append(f"{where}: {before} -> {value}")
    return found


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--check", action="store_true", help="compare against ci/lint-baseline.json")
    args = ap.parse_args()

    current = {"shellcheck": run_shellcheck(), "qmllint": run_qmllint()}

    if not args.check:
        os.makedirs(os.path.dirname(BASELINE), exist_ok=True)
        with open(BASELINE, "w") as fh:
            json.dump(current, fh, indent=2, sort_keys=True)
            fh.write("\n")
        print(f"shellcheck: {current['shellcheck']['total']} findings in {current['shellcheck']['files']} files")
        print(f"qmllint:    {current['qmllint']['total']} findings in {current['qmllint']['files']} files")
        return 0

    with open(BASELINE) as fh:
        baseline = json.load(fh)
    worse = regressions(baseline, current)
    for line in worse:
        print(f"regression: {line}", file=sys.stderr)
    if not worse:
        print("lint counts at or below baseline")
    return 1 if worse else 0


if __name__ == "__main__":
    sys.exit(main())
