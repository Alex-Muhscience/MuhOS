def main():
    with open(os.path.join(ASSETS, "logo.svg"), "w") as fh:
        fh.write(LOGO_SVG)
    print("wrote src/assets/logo.svg")
    save(os.path.join(ASSETS, "pushy.gif"), [moon_frame(i) for i in range(FRAMES)])
    save(os.path.join(ASSETS, "pushy2.gif"), [cloud_frame(i) for i in range(FRAMES)])
    print("wrote src/assets/pushy.gif and src/assets/pushy2.gif")

    walls = os.path.join(ASSETS, "wallpapers")
    wallpaper(os.path.join(walls, "muhos-dusk.jpg"), (18, 20, 36), (44, 34, 78), [
        ((40, 38, 74), 0.52, 0.035, 1.0, 0.4, 0.75),
        ((58, 46, 98), 0.64, 0.030, 1.4, 2.1, 0.80),
        ((82, 62, 128), 0.76, 0.025, 0.8, 4.0, 0.85),
        ((30, 26, 52), 0.88, 0.020, 1.7, 1.2, 0.95),
    ], seed=1)
    wallpaper(os.path.join(walls, "muhos-dawn.jpg"), (236, 228, 240), (200, 184, 220), [
        ((214, 196, 226), 0.50, 0.035, 1.1, 1.0, 0.70),
        ((186, 160, 210), 0.63, 0.030, 0.9, 3.0, 0.75),
        ((150, 124, 186), 0.76, 0.025, 1.5, 0.3, 0.80),
        ((112, 92, 152), 0.88, 0.020, 1.2, 2.2, 0.90),
    ], seed=2)
    print("wrote src/assets/wallpapers/muhos-dusk.jpg and muhos-dawn.jpg")


if __name__ == "__main__":
    main()
