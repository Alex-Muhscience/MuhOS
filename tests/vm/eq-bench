#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# MuhOS: compare equaliser engines inside a running MuhOS session (run in the
# test VM, as the session user).
#
#   tests/vm/eq-bench easyeffects|filterchain [seconds] [runs]
#
# Both engines get the same 10-band EQ (32 Hz-16 kHz, the shell's bands, the
# same gains) while the same test audio plays. Reports, per run, the engine
# process's memory (PSS, median of samples every 2 s) and CPU (share of one
# core over the playback). easyeffects: MuhOS's current backend
# (src/quickshell/media/equalizer.sh). filterchain: a separate PipeWire
# process with ten built-in peaking filters per channel.

set -euo pipefail

engine="${1:?usage: eq-bench easyeffects|filterchain [seconds] [runs]}"
secs="${2:-60}"
runs="${3:-3}"
work="${XDG_RUNTIME_DIR:-/tmp}/muhos-eq-bench"
mkdir -p "$work"
audio="$work/test.wav"
freqs=(32 63 125 250 500 1000 2000 4000 8000 16000)
gains=(4 3 1 -1 -2 0 2 3 4 2)
hz=$(getconf CLK_TCK)

# Test audio: a chord with slowly moving partials and a little noise, so every
# band has signal (48 kHz stereo).
if [ ! -s "$audio" ] || [ "$(python3 -c "import wave;print(int(wave.open('$audio').getnframes()/48000))")" -lt "$secs" ]; then
    python3 -I - "$audio" "$secs" <<'PY'
import math, random, struct, sys, wave
path, secs, rate = sys.argv[1], int(sys.argv[2]), 48000
rng = random.Random(1)
partials = [55, 110, 220, 330, 440, 880, 1760, 3520, 7040, 12000]
with wave.open(path, "wb") as out:
    out.setnchannels(2); out.setsampwidth(2); out.setframerate(rate)
    frames = bytearray()
    for i in range(secs * rate):
        t = i / rate
        s = sum(math.sin(2 * math.pi * f * (1 + 0.002 * math.sin(t)) * t) for f in partials) / len(partials)
        s = 0.5 * s + 0.05 * (rng.random() * 2 - 1)
        v = int(max(-1, min(1, s)) * 20000)
        frames += struct.pack("<hh", v, v)
        if len(frames) > 1 << 20:
            out.writeframesraw(frames); frames.clear()
    out.writeframesraw(frames)
PY
fi

pss() { awk '/^Pss:/ {print $2; exit}' "/proc/$1/smaps_rollup" 2>/dev/null || echo 0; }
ticks() { awk '{print $14 + $15}' "/proc/$1/stat"; }

start_easyeffects() {
    local eq=/usr/share/muhos/src/quickshell/media/equalizer.sh
    for i in "${!gains[@]}"; do bash "$eq" set_band "$((i + 1))" "${gains[$i]}"; done
    bash "$eq" apply
    for _ in $(seq 30); do
        pid=$(pgrep -xo easyeffects || true)
        [ -n "$pid" ] && pw-dump 2>/dev/null | grep -q '"node.name": "easyeffects_sink"' && break
        sleep 1
    done
    [ -n "${pid:-}" ] || { echo "easyeffects did not start" >&2; exit 1; }
    sleep 5   # let it load the preset
    target=easyeffects_sink
}

start_filterchain() {
    local conf="$work/eq.conf" nodes="" links="" prev=""
    for i in "${!freqs[@]}"; do
        nodes+="{ type = builtin label = bq_peaking name = eq$i control = { \"Freq\" = ${freqs[$i]} \"Q\" = 1.0 \"Gain\" = ${gains[$i]}.0 } }"$'\n'
        [ -n "$prev" ] && links+="{ output = \"$prev:Out\" input = \"eq$i:In\" }"$'\n'
        prev="eq$i"
    done
    cat > "$conf" <<EOF
context.properties = { log.level = 0 }
context.spa-libs = { audio.convert.* = audioconvert/libspa-audioconvert support.* = support/libspa-support }
context.modules = [
  { name = libpipewire-module-rt flags = [ ifexists nofail ] }
  { name = libpipewire-module-protocol-native }
  { name = libpipewire-module-client-node }
  { name = libpipewire-module-adapter }
  { name = libpipewire-module-filter-chain
    args = {
      node.description = "MuhOS equaliser (bench)"
      media.name = "MuhOS equaliser (bench)"
      filter.graph = {
        nodes = [
$nodes        ]
        links = [
$links        ]
      }
      audio.channels = 2
      audio.position = [ FL FR ]
      capture.props = { node.name = "muhos_eq_bench" media.class = Audio/Sink }
      playback.props = { node.name = "muhos_eq_bench.output" node.passive = true }
    }
  }
]
EOF
    pipewire -c "$conf" >"$work/filterchain.log" 2>&1 &
    pid=$!
    for _ in $(seq 20); do
        pw-dump 2>/dev/null | grep -q '"node.name": "muhos_eq_bench"' && break
        sleep 0.5
    done
    sleep 2
    target=muhos_eq_bench
}

stop_engine() {
    if [ "$engine" = easyeffects ]; then
        easyeffects -q >/dev/null 2>&1 || kill "$pid" 2>/dev/null || true
    else
        kill "$pid" 2>/dev/null || true
    fi
    sleep 3
}

echo "engine=$engine seconds=$secs runs=$runs"
for run in $(seq "$runs"); do
    "start_$engine"
    t0=$(ticks "$pid")
    pw-play --target="$target" "$audio" &
    player=$!
    samples=()
    for _ in $(seq $((secs / 2))); do
        sleep 2
        samples+=("$(pss "$pid")")
    done
    wait "$player" 2>/dev/null || true
    t1=$(ticks "$pid")
    median=$(printf '%s\n' "${samples[@]}" | sort -n | awk '{a[NR]=$1} END {print a[int((NR+1)/2)]}')
    cpu=$(awk -v d=$((t1 - t0)) -v hz="$hz" -v s="$secs" 'BEGIN {printf "%.2f", 100 * d / hz / s}')
    printf 'run %d: pss_mib=%.1f cpu_pct=%s\n' "$run" "$(awk -v k="$median" 'BEGIN {print k / 1024}')" "$cpu"
    stop_engine
done
