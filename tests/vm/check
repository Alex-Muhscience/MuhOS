#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# MuhOS: check the MuhOS session in a running test VM (see tests/vm/run).
#
#   tests/vm/check <vm-dir> [idle-seconds]
#
# Waits for SSH, then verifies the GDM autologin session, Hyprland, the
# systemd units, the shell process and the per-user files; prints the shell
# log; samples the shell's memory (PSS/RSS) and CPU over [idle-seconds]
# (default 60) of idle; takes a screenshot. Exit status is the number of
# failed checks. Resource numbers come from software rendering in a VM and are
# only comparable with other runs of this same setup.

# Single-quoted commands below run inside the guest; they must not expand here.
# shellcheck disable=SC2016
set -uo pipefail

dir="$(realpath "${1:?usage: check <vm-dir> [idle-seconds]}")"
idle="${2:-60}"
here="$(dirname "$(realpath "$0")")"
fails=0

vm() {
    ssh -q -i "$dir/id_ed25519" -p 2222 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o ConnectTimeout=5 -o BatchMode=yes muhos@127.0.0.1 "$@"
}
pass() { printf 'ok    %s\n' "$*"; }
fail() { printf 'FAIL  %s\n' "$*"; fails=$((fails + 1)); }
check() { local d="$1"; shift; if vm "$@" >/dev/null 2>&1; then pass "$d"; else fail "$d"; fi; }

printf 'waiting for ssh'
for _ in $(seq 120); do vm true 2>/dev/null && break; printf '.'; sleep 5; done
echo
vm true || { fail "ssh reachable"; exit 1; }

# Give GDM, the session and the shell time to come up.
for _ in $(seq 60); do vm 'pgrep -u muhos -x quickshell || pgrep -u muhos -f "quickshell -p"' >/dev/null 2>&1 && break; sleep 5; done
sleep 10

echo "== session"
vm 'loginctl list-sessions --no-legend; for s in $(loginctl list-sessions --no-legend | awk "\$3==\"muhos\"{print \$1}"); do loginctl show-session "$s" -p Type -p Desktop -p State -p Class; done'
check "graphical wayland session for muhos" 'loginctl list-sessions --no-legend | awk "\$3==\"muhos\"{print \$1}" | while read s; do loginctl show-session "$s" -p Type --value; done | grep -qx wayland'
check "Hyprland running" 'pgrep -u muhos -x Hyprland'
check "muhos-session.target active" 'systemctl --user is-active muhos-session.target'
check "muhos-shell.service active" 'systemctl --user is-active muhos-shell.service'
restarts="$(vm 'systemctl --user show muhos-shell.service -p NRestarts --value' 2>/dev/null)"
if [ "${restarts:-x}" = 0 ]; then pass "shell never restarted"; else fail "shell restarted ${restarts:-?} time(s)"; fi
check "quickshell process running" 'pgrep -u muhos -f "quickshell -p"'
check "per-user Hyprland stub created" 'test -f ~/.config/muhos/hypr/hyprland.lua'
check "settings seeded" 'test -f ~/.config/serpantinum/settings.json'
check "user's ~/.config/hypr left alone" 'test ! -e ~/.config/hypr'
check "pid/lock in XDG_RUNTIME_DIR" 'test -f /run/user/$(id -u)/serpantinumd.pid'
check "nothing in /tmp from the daemon" 'test ! -e /tmp/serpantinumd.pid'

echo "== shell log (last 40 lines)"
vm 'journalctl --user -u muhos-shell -b --no-pager -o cat | tail -n 40'
echo "== log summary"
vm 'journalctl --user -u muhos-shell -b --no-pager -o cat | grep -ciE "error|fatal|segfault|core dumped"' | sed 's/^/error-like lines: /'

echo "== idle resources over ${idle}s"
vm "pid=\$(pgrep -u muhos -f 'quickshell -p' | head -n1); hz=\$(getconf CLK_TCK);
    t0=\$(awk '{print \$14+\$15}' /proc/\$pid/stat); sleep $idle; t1=\$(awk '{print \$14+\$15}' /proc/\$pid/stat);
    awk -v a=\$t0 -v b=\$t1 -v hz=\$hz -v s=$idle 'BEGIN{printf \"quickshell CPU: %.2f%% of one core\n\", (b-a)/hz/s*100}';
    awk '/^Pss:|^Rss:/{printf \"quickshell %s %.1f MiB\n\", \$1, \$2/1024}' /proc/\$pid/smaps_rollup;
    for p in Hyprland; do q=\$(pgrep -u muhos -x \$p | head -n1); [ -n \"\$q\" ] && awk -v n=\$p '/^Pss:/{printf \"%s Pss: %.1f MiB\n\", n, \$2/1024}' /proc/\$q/smaps_rollup; done"

shot="$dir/screenshot-$(date +%Y%m%d-%H%M%S).png"
"$here/run" screenshot "$dir" "$shot" >/dev/null && echo "screenshot: $shot"

echo
[ "$fails" -eq 0 ] && echo "all checks passed" || echo "$fails check(s) failed"
exit "$fails"
